# Public site origin used by the catalog API CORS policy
APP_ORIGIN=https://moviecloudproject.vercel.app

# Comma-separated hostnames that you own or are explicitly authorized to relay.
# Keep empty until legal media sources are configured; the gateway fails closed.
ALLOWED_STREAM_HOSTS=media.example.com,cdn.example.com

# Optional Cloudflare Stream customer code. When set, catalog entries using
# delivery=cloudflare-stream and playbackId are hydrated to public HLS URLs.
# Keep videos public only when the license allows public playback.
CLOUDFLARE_STREAM_CUSTOMER_CODE=your_customer_code
