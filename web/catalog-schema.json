{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MovieCloud authorized media catalog",
  "type": "object",
  "required": ["version", "description", "providers", "titles"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string"},
    "featured": {"type": "array", "items": {"type": "string"}},
    "trending": {"type": "array", "items": {"type": "string"}},
    "providers": {"type": "object", "additionalProperties": {"$ref": "#/$defs/provider"}},
    "titles": {"type": "array", "items": {"$ref": "#/$defs/title"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["label", "type"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "type": {"type": "string", "enum": ["MP4", "HLS"]},
        "url": {"type": "string", "format": "uri"},
        "delivery": {"type": "string", "enum": ["cloudflare-stream", "cdn"]},
        "playbackId": {"type": "string", "minLength": 6, "maxLength": 128},
        "live": {"type": "boolean", "description": "True for an authorized live HLS/MP4 channel."},
        "subtitles": {"type": "array", "items": {"type": "object", "required": ["label", "url"], "properties": {"label": {"type": "string"}, "url": {"type": "string", "format": "uri"}}}}
      }
    },
    "provider": {"type": "object", "required": ["sources"], "properties": {"sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}}},
    "title": {
      "type": "object",
      "required": ["id", "title", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "year": {"type": "integer", "minimum": 1888, "maximum": 2200},
        "language": {"type": "string", "maxLength": 80},
        "genres": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string", "maxLength": 2000},
        "runtime": {"type": "string", "maxLength": 30},
        "poster": {"type": "string", "format": "uri"},
        "provider": {"type": "string"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    }
  }
}
